# RouteDiscover runtime configuration. Copy to .env.local and edit.
# Every value is optional; the defaults use free public services.

# auto (default): live providers, falling back to bundled sample data when they fail
# live: live providers only, errors surface to the user
# demo: bundled sample data only (offline development)
ROUTEDISCOVER_DATA_MODE=auto

# Google Maps Platform. With a key, the map uses Google Maps and listings use
# Google Places (hours, phone, website, rating, reviews, photos) first; without
# one, OpenStreetMap is used. Can also be entered in the owner console.
# Enable: Maps JavaScript API, Places API (New), Routes API, Geocoding API.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Open Charge Map API key (free at https://openchargemap.org/site/develop/api).
# Optional, but requests with a key get higher rate limits.
OPENCHARGEMAP_API_KEY=

# Self-hosted or commercial endpoints. The public demo servers below are rate-limited
# and fine for development; run your own (or use a hosted provider) for production.
OSRM_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
OPENCHARGEMAP_URL=https://api.openchargemap.io/v3

# Map tiles (client side). OpenStreetMap's tiles are for light use only; for production
# point this at a tile provider such as MapTiler, Stadia, or Thunderforest.
NEXT_PUBLIC_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Sent as the User-Agent to the OSM services, which ask apps to identify themselves.
ROUTEDISCOVER_USER_AGENT=RouteDiscover/0.1 (contact: you@example.com)
ROUTEDISCOVER_FETCH_TIMEOUT_MS=25000

# ---------------------------------------------------------------------------
# Accounts, billing and the owner console
# ---------------------------------------------------------------------------
# Postgres connection for production (Render, Neon, Supabase, RDS…). When unset,
# an embedded PGlite database is created in ./data/pglite (fine for dev and tests).
DATABASE_URL=
# Encrypts API keys the owner saves in the console. Generate: openssl rand -hex 32
# In development a key is generated once into ./data/app-secret if this is unset.
APP_SECRET=
# Public URL of the site, used in share links, invite emails and Stripe return URLs.
# Production defaults to https://routediscover.com; set this for staging or local use.
NEXT_PUBLIC_SITE_URL=https://routediscover.com

# Everything below can be entered in the owner console instead (Integrations page);
# values here are fallbacks when the console field is blank.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
